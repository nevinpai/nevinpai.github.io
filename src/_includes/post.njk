---
layout: base.njk
---
<article class="post">
  <p class="post-date"><time datetime="{{ page.date | dateISO }}">{{ page.date | dateLong }}</time></p>
  <h1>{{ title }}</h1>
  {% if description %}<p class="post-sub">{{ description }}</p>{% endif %}
  <div class="prose">{{ content | safe }}</div>
  <p class="back"><a href="/writing/">Back to all writing</a></p>
</article>
